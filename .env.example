# Copy this file to .env and adjust values for local development.

# --- Backend (FastAPI) ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
# Comma-separated. Both are Vite dev-server ports (5173 default, 5174
# when 5173 is already taken).
BACKEND_CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# --- Database (PostgreSQL + PostGIS, via docker-compose.yml) ---
# Host port 5433 is used (not 5432) to avoid colliding with any other
# local Postgres instance. See README.md for the docker compose command.
DATABASE_URL=postgresql+psycopg://crime_tracker:crime_tracker@localhost:5433/crime_tracker

# Used only by the test suite, so tests never touch the DATABASE_URL
# database above. Defaults to DATABASE_URL with "_test" appended if unset.
TEST_DATABASE_URL=postgresql+psycopg://crime_tracker:crime_tracker@localhost:5433/crime_tracker_test

# How many consecutive *complete* reconciliation runs must miss a source
# record before we consider it confirmed-removed by the source (rather
# than a transient gap). See docs/ingestion-framework.md.
REMOVAL_CONFIRMATION_RUNS=2

# --- Chicago source (see docs/operations/chicago-ingestion.md) ---
# Optional. Anonymous access to Chicago's Socrata API works without one
# (see docs/sources/chicago.md §9) -- an app token just avoids the
# shared, unthrottled-guarantee-free anonymous IP pool for real,
# repeated ingestion. Get a free one at https://data.cityofchicago.org/profile/edit/developer_settings
# NEVER commit a real value here.
CHICAGO_APP_TOKEN=

# --- Frontend (Vite) ---
# Use 127.0.0.1, not localhost -- on this project's dev setup,
# "localhost:8000" resolves to an unrelated service.
VITE_API_BASE_URL=http://127.0.0.1:8000
